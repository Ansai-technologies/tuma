# Tuma — copy to .env and fill in. NEVER commit real values.
# Values marked FOUNDER must come from the founder (see README "Setup checklist").

# --- Trust Engine (Track A: attestation infrastructure) ---
# mock  = in-process MockTrustEngine (default; Track A not yet deployed)
# http  = live core at TRUST_ENGINE_BASE_URL
TRUST_ENGINE_MODE=mock
# FOUNDER: Trust Engine base URL + API key, once Track A deploys
TRUST_ENGINE_BASE_URL=
TRUST_ENGINE_API_KEY=
# Shared secret to verify attestation.completed/failed webhook signatures.
# Must match the value Track A registers on our webhook URL.
# FOUNDER: generate once, store in a secrets manager (not in chat)
ATTESTATION_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (scaffold only) ---
# FOUNDER: from Meta Business dashboard
WHATSAPP_TOKEN=            # permanent access token (system user token)
WHATSAPP_PHONE_NUMBER_ID=  # WhatsApp phone number ID
WHATSAPP_BUSINESS_ACCOUNT_ID= # WhatsApp Business Account ID
WHATSAPP_VERIFY_TOKEN=     # webhook verify token (we choose this value)

# --- Daraja sandbox (STK push) ---
# FOUNDER: from the Safaricom Developer Portal (sandbox app)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=          # sandbox shortcode
DARAJA_PASSKEY=            # sandbox LNM passkey
# Public HTTPS URL of /api/mpesa/stk-result (this deployment)
DARAJA_STK_CALLBACK_URL=

# --- Vendor till / paybill registered for Safaricom C2B callbacks ---
# FOUNDER: vendor till or paybill number (e.g. 567890); C2B callbacks for it
# are registered against the Trust Engine's /mpesa/c2b/callback (Track A).
VENDOR_TILL=
